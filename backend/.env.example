# Required — OpenAI API key for the agent LLM (gpt-4o)
OPENAI_API_KEY=

# Phase 3+ — PostgreSQL + pgvector (start with: docker compose -f ops/docker-compose.yml up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent

# Phase 6+ — OTLP trace export (Arize Phoenix; start with docker compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# Set to true to run the agent without Phoenix (noop SDK; no OTLP export noise
# when compose is down). /chat and the CLI still work.
# OTEL_SDK_DISABLED=true

# PORT=3000

# Grafana is on http://localhost:3002 (compose). Prometheus scrapes this process
# at GET /metrics — leave the agent running (`bun run dev`) so dashboards fill.
# Optional POST /chat { userId, scenario?, requestId? } (or CLI --user / --scenario).
# Scenarios (P14): slow_tool | tool_failure | bad_retrieval | token_heavy | llm_timeout
# token_heavy sends ~80k input tokens (~$0.40 at Opus 5 rates).
# Invalid userId → anonymous. Inbound x-request-id is echoed as the correlation id.
